{
  "name": "@lbss/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "backfill-game-stats": "tsx --env-file=../../.env scripts/backfill-game-stats.ts",
    "db:set-password": "tsx --env-file=../../.env scripts/set-user-password.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@lbss/shared": "workspace:*",
    "argon2": "^0.41.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.39.0",
    "fastify": "^5.2.0",
    "fastify-socket.io": "^5.1.0",
    "nanoid": "^5.1.0",
    "postgres": "^3.4.0",
    "socket.io": "^4.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
