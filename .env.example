# Database
DATABASE_URL=postgres://lbss:lbss_dev_password@localhost:5432/lbss

# API Server
API_PORT=3002

# Seed (local dev only; `pnpm db:seed` wipes all data and refuses to run when NODE_ENV=production)
# SEED_ADMIN_PASSWORD=Choose-A-Strong-Password-1!

# Stripe (Phase 2)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend URLs (used by API for CORS)
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Web app: URL of the API (required in production e.g. Railway)
# Set this on the *web* service to your API service URL, e.g. https://your-api.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3002

# Optional: server-side only (Next.js proxy + SSR). Use when the public URL is not reachable from the web container.
# INTERNAL_API_URL=http://api:3002

# Admin production server (apps/admin/start.mjs): API base the admin proxies /api to
# API_URL=https://your-api.railway.app
