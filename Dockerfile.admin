# pnpm monorepo Vite admin app for Railway (Node 20)
# Use this Dockerfile ONLY for the @lbss/admin service.
#
# In Railway for the admin service:
#   - Root Directory: leave empty (or "/")
#   - Dockerfile path: Dockerfile.admin
#   - Do NOT set a custom start command; use the image CMD (production "start", not "dev").
FROM node:20-slim

RUN corepack enable && corepack prepare pnpm@10.6.0 --activate

WORKDIR /app

# Copy dependency manifests (repo root + shared + admin)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/admin/package.json apps/admin/

RUN pnpm install --frozen-lockfile

# Copy source
COPY packages/shared packages/shared
COPY apps/admin apps/admin

# API URL for admin to call in production (set in Railway: Variables or Build → Build Args)
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm --filter @lbss/admin build

ENV NODE_ENV=production
EXPOSE 4173

# Production only: run "start" (serve on 0.0.0.0:$PORT). Do not override with "dev" in Railway.
CMD pnpm --filter @lbss/admin start
